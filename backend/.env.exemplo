# Copie este arquivo para ".env" e ajuste os valores.
# O .env NUNCA vai para o GitHub nem para o deploy (está no .gitignore).

# ---- Banco de dados ----
# Local (docker compose up -d):
DATABASE_URL=postgres://usuario:senha@localhost:5432/gestorml
# No alwaysdata fica assim:
# DATABASE_URL=postgres://USUARIO:SENHA@postgresql-CONTA.alwaysdata.net:5432/CONTA_gestorml

# ---- Login do sistema ----
# Usuário e senha que o vendedor digita na tela de entrada.
USUARIO_ACESSO=vendedor
SENHA_ACESSO=troque-esta-senha

# Segredo usado para assinar o token de sessão.
# Gere um valor aleatório com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_TOKEN=troque-por-um-valor-aleatorio-longo
